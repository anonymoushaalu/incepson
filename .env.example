# Hedera testnet - agent's paying account
HEDERA_ACCOUNT_ID=0.0.xxxxx
HEDERA_PRIVATE_KEY=
# ED25519 or ECDSA -- check the account's actual on-chain key type, don't guess:
# curl -s https://testnet.mirrornode.hedera.com/api/v1/accounts/<id> | grep _type
HEDERA_KEY_TYPE=ED25519

# Hedera testnet - merchant's receiving account
MERCHANT_ACCOUNT_ID=0.0.xxxxx

# Verified: public, no API key, advertises hedera:testnet
X402_FACILITATOR_URL=https://x402.org/facilitator
HEDERA_NETWORK=hedera:testnet

# OpenAI - agent tool-calling loop
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Shared with the ESP32 at flash time. Never served over the network.
DEVICE_HMAC_SECRET=

PORT=3000
MERCHANT_PORT=4001
DB_PATH=./agentpay.db
