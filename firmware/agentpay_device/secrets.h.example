// Copy to secrets.h (gitignored) and fill in real values before compiling.
// DEVICE_HMAC_SECRET must be byte-identical to .env's DEVICE_HMAC_SECRET.
#pragma once

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// Backend LAN IP, not localhost -- the ESP32 cannot reach the host's loopback.
#define BACKEND_HOST "http://192.168.1.100:3000"

// Same 64-char hex string as .env's DEVICE_HMAC_SECRET. Provisioned at flash
// time, never fetched at runtime.
#define DEVICE_HMAC_SECRET "paste-the-same-64-hex-char-secret-from-.env-here"
